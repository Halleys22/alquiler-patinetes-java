<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="alquilerpatin.controladores.ListaPatinetesController"
      prefWidth="720.0" styleClass="app-shell" stylesheets="@estilos.css">
    <HBox alignment="CENTER_LEFT" styleClass="dialog-header">
        <Label text="Lista de patinetes" styleClass="page-title"/>
    </HBox>
    <VBox spacing="12.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="18.0" right="26.0" bottom="16.0" left="26.0"/>
        </padding>
        <TableView fx:id="tablaPatinetes" accessibleText="Catálogo de patinetes" fixedCellSize="36.0"
                   minHeight="398.0" prefHeight="398.0" maxHeight="398.0">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="serieCol" text="Nº serie" minWidth="85.0" prefWidth="104.0" sortable="false"/>
                <TableColumn fx:id="colorCol" text="Color" minWidth="95.0" prefWidth="131.0" sortable="false"/>
                <TableColumn fx:id="modeloCol" text="Modelo" minWidth="145.0" prefWidth="235.0" sortable="false"/>
                <TableColumn fx:id="marcaCol" text="Marca" minWidth="110.0" prefWidth="160.0" sortable="false"/>
            </columns>
            <placeholder>
                <Label text="No hay patinetes disponibles." styleClass="muted-label"/>
            </placeholder>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label fx:id="totalLabel" styleClass="muted-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="anteriorButton" text="‹ Anterior" accessibleText="Página anterior" disable="true"
                    styleClass="page-button" onAction="#paginaAnterior"/>
            <Label fx:id="paginaLabel" text="Página 1 de 1" minWidth="112.0" alignment="CENTER" styleClass="page-label"/>
            <Button fx:id="siguienteButton" text="Siguiente ›" accessibleText="Página siguiente" disable="true"
                    styleClass="page-button" onAction="#paginaSiguiente"/>
        </HBox>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="action-bar">
        <Button fx:id="cancelarButton" text="Cancelar" cancelButton="true" onAction="#cancelar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="seleccionarButton" text="Seleccionar" defaultButton="true" disable="true"
                styleClass="primary-button" onAction="#seleccionar"/>
    </HBox>
</VBox>
