<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="alquilerpatin.controladores.ConsultaController"
      prefWidth="800.0" prefHeight="570.0" styleClass="app-shell" stylesheets="@estilos.css">
    <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="app-header">
        <StackPane styleClass="app-mark">
            <SVGPath styleClass="scooter-icon"
                     content="M4 16 a3 3 0 1 0 6 0 a3 3 0 1 0 -6 0 M18 16 a3 3 0 1 0 6 0 a3 3 0 1 0 -6 0 M7 16 h9 l4 -11 h-4 M20 5 l1 11"/>
        </StackPane>
        <Label text="Alquiler de patinetes" styleClass="app-name"/>
    </HBox>

    <VBox spacing="12.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20.0" right="26.0" bottom="16.0" left="26.0"/>
        </padding>
        <Label text="Consulta de alquileres" styleClass="page-title"/>
        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
            <VBox spacing="5.0">
                <Label text="DNI (9 caracteres)" styleClass="field-label"/>
                <TextField fx:id="dniField" accessibleText="DNI" prefWidth="228.0" promptText="12345678A"
                           onAction="#buscar"/>
            </VBox>
            <Button fx:id="buscarButton" text="Buscar" defaultButton="true" styleClass="primary-button"
                    onAction="#buscar"/>
        </HBox>
        <Label fx:id="avisoLimiteDni" minHeight="18.0" styleClass="input-error"/>
        <TableView fx:id="tablaAlquileres" accessibleText="Alquileres del usuario" fixedCellSize="36.0"
                   minHeight="218.0" prefHeight="218.0" maxHeight="218.0">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="nombreCol" text="Nombre completo" minWidth="165.0" prefWidth="270.0" sortable="false"/>
                <TableColumn fx:id="serieCol" text="Nº serie" minWidth="88.0" prefWidth="112.0" sortable="false"/>
                <TableColumn fx:id="recogidaCol" text="Fecha de recogida" minWidth="130.0" prefWidth="158.0" sortable="false"/>
                <TableColumn fx:id="devolucionCol" text="Fecha de devolución" minWidth="146.0" prefWidth="178.0" sortable="false"/>
            </columns>
            <placeholder>
                <Label fx:id="sinResultadosLabel" text="Introduce un DNI y pulsa Buscar." styleClass="muted-label"/>
            </placeholder>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label fx:id="totalLabel" styleClass="muted-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="anteriorButton" text="‹ Anterior" accessibleText="Página anterior" disable="true"
                    styleClass="page-button" onAction="#paginaAnterior"/>
            <Label fx:id="paginaLabel" text="Página 1 de 1" minWidth="112.0" alignment="CENTER" styleClass="page-label"/>
            <Button fx:id="siguienteButton" text="Siguiente ›" accessibleText="Página siguiente" disable="true"
                    styleClass="page-button" onAction="#paginaSiguiente"/>
        </HBox>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="action-bar">
        <Button fx:id="salirButton" text="Salir" onAction="#salir"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="eliminarButton" text="Eliminar" styleClass="danger-button" disable="true" onAction="#eliminar"/>
        <Button fx:id="altaButton" text="Alta" styleClass="primary-button" onAction="#alta"/>
    </HBox>
</VBox>
